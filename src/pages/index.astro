---
// Página provisória (Etapa 0). Será substituída pela nova landing page na Etapa 3.
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Metastorm — plataforma de torneios de e-Sports. Site em reconstrução." />
    <link rel="icon" type="image/png" href={`${base}favicon.png`} />
    <title>Metastorm — em reconstrução</title>
    <style>
      :root { color-scheme: dark; }
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        background: #1b1d21;
        color: #f8f8f8;
        font-family: system-ui, sans-serif;
        text-align: center;
        padding: 1rem;
      }
      h1 { margin: 0; font-size: clamp(2rem, 8vw, 4rem); letter-spacing: 0.05em; }
      span { color: #f36422; }
      p { opacity: 0.8; }
    </style>
  </head>
  <body>
    <main>
      <h1>META<span>STORM</span></h1>
      <p>Site em reconstrução.</p>
    </main>
  </body>
</html>
