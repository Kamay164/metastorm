---
/** Página inicial (landing page). Textos e conteúdo vêm de src/data/. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionTitle from '../components/SectionTitle.astro';
import GameMarquee from '../components/GameMarquee.astro';
import LevelCard from '../components/LevelCard.astro';
import StepCard from '../components/StepCard.astro';
import LiveVideo from '../components/LiveVideo.astro';
import { jogos } from '../data/jogos';
import { niveis } from '../data/niveis';
import { etapas } from '../data/etapas';
---

<BaseLayout
  title="Metastorm"
  description="Gerencie e participe de ligas e campeonatos dos seus jogos favoritos de e-Sports."
>
  <Hero />

  <!-- Jogos: texto + carrossel infinito -->
  <section class="secao tom-claro" aria-labelledby="titulo-jogos">
    <div class="container jogos">
      <SectionTitle
        id="titulo-jogos"
        title="Explore seu lado competitivo criando e participando de torneios de qualquer jogo"
        caps={false}
      />
      <div data-revelar><GameMarquee jogos={jogos} label="Jogos disponíveis para torneios" /></div>
    </div>
  </section>

  <!-- Níveis de competição -->
  <section id="competicoes" class="secao tom-escuro" aria-labelledby="titulo-niveis">
    <div class="container pilha">
      <SectionTitle id="titulo-niveis" title="Competições para todos os níveis" revelar />
      <ul class="niveis" role="list">
        {niveis.map((nivel, i) => <li data-revelar style={`--atraso:${i * 90}ms`}><LevelCard nivel={nivel} /></li>)}
      </ul>
    </div>
  </section>

  <!-- Etapas do torneio -->
  <section id="etapas" class="secao tom-laranja" aria-labelledby="titulo-etapas">
    <div class="container pilha">
      <SectionTitle id="titulo-etapas" title="Cuidamos de todas as etapas" revelar />
      <ol class="etapas" role="list">
        {etapas.map((etapa, i) => <StepCard titulo={etapa.titulo} texto={etapa.texto} atraso={i * 90} />)}
      </ol>
    </div>
  </section>

  <!-- Transmissões ao vivo: vídeo mudo em loop -->
  <section id="ao-vivo" class="secao tom-claro" aria-labelledby="titulo-ao-vivo">
    <div class="container pilha">
      <SectionTitle
        id="titulo-ao-vivo"
        title="Torneios e transmissões ao vivo, uma combinação perfeita"
        lead="Acompanhe as transmissões dos seus campeonatos pela nossa plataforma."
        align="center"
        revelar
      />
      <div class="palco" data-revelar>
        <LiveVideo label="Trecho de gameplay de CS:GO da transmissão do IEM Rio Major 2022, em vídeo mudo e em loop" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .pilha {
    display: grid;
    gap: var(--e-7);
  }

  /* ---------- Jogos ---------- */
  .jogos {
    display: grid;
    /* minmax(0, …): sem isso a coluna estica até a largura da faixa do carrossel e corta o título */
    grid-template-columns: minmax(0, 1fr);
    gap: var(--e-7);
    align-items: center;
  }

  /* ---------- Níveis ---------- */
  .niveis {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--e-5);
    padding: 0;
    list-style: none;
  }

  /* ---------- Etapas ---------- */
  .etapas {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--e-5);
    padding: 0;
    list-style: none;
    counter-reset: etapa;
  }

  /* ---------- Transmissões ---------- */
  /* moldura laranja com cantos chanfrados: o padding vira a "borda" */
  .palco {
    width: 100%;
    max-width: 64rem;
    margin-inline: auto;
    padding: 0.3125rem;
    background: var(--c-brasa);
    clip-path: polygon(
      1.5rem 0,
      100% 0,
      100% calc(100% - 1.5rem),
      calc(100% - 1.5rem) 100%,
      0 100%,
      0 1.5rem
    );
  }

  @media (min-width: 480px) {
    .niveis,
    .etapas {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .jogos {
      grid-template-columns: minmax(0, 26rem) minmax(0, 1fr);
      gap: var(--e-8);
    }

    .niveis,
    .etapas {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
