---
/**
 * Barra do usuário logado (baseada na pasta BarraNav do site original).
 * Desktop (≥ 1024px): logo, links, moedas e "Sair" numa linha só, como no original.
 * Celular/tablet: logo + moedas em cima e os links numa faixa que rola na horizontal (só ela, não a página).
 * Demonstração: os itens levam às seções do painel, nada vem de um servidor.
 */
import logoBranco from '../assets/logo/logo-branco.svg';
import moeda from '../assets/images/moeda.webp';
import { painelLinks, usuario } from '../data/painel';

const base = import.meta.env.BASE_URL;
---

<header class="barra">
  <div class="container barra__grade">
    <a class="barra__logo" href={`${base}painel/`} aria-label="Metastorm, painel">
      <img src={logoBranco.src} width="160" height="25" alt="" />
    </a>

    <nav class="barra__nav" aria-label="Painel">
      <ul class="barra__links" role="list">
        {painelLinks.map((l) => <li><a href={`#${l.id}`}>{l.label}</a></li>)}
      </ul>
    </nav>

    <p class="barra__moedas">
      <img src={moeda.src} width="20" height="20" alt="" />
      <span class="sr-only">Moedas:</span>
      <span>{usuario.moedas}</span>
    </p>

    <a class="barra__sair" href={base}>Sair</a>
  </div>
</header>

<style>
  .barra {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--c-carvao);
    border-bottom: 1px solid var(--c-aco);
  }

  .barra__grade {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    grid-template-areas:
      'logo . moedas sair'
      'nav nav nav nav';
    align-items: center;
    column-gap: var(--e-4);
  }

  .barra__logo {
    grid-area: logo;
    padding-block: var(--e-3);
  }

  .barra__logo img {
    width: 8.5rem;
    height: auto;
  }

  .barra__moedas {
    grid-area: moedas;
    display: inline-flex;
    align-items: center;
    gap: var(--e-2);
    padding: var(--e-1) var(--e-3);
    border: 1px solid var(--c-aco);
    color: var(--c-gelo);
    font-weight: 700;
    font-size: var(--t-sm);
    white-space: nowrap;
  }

  .barra__sair {
    grid-area: sair;
    color: var(--c-nevoa);
    font-size: var(--t-sm);
  }

  .barra__sair:hover {
    color: var(--c-gelo);
  }

  /* links numa faixa rolável só nela mesma, para caber em 360px sem rolar a página */
  .barra__nav {
    grid-area: nav;
    min-width: 0;
    border-top: 1px solid var(--c-aco);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .barra__links {
    display: flex;
    gap: var(--e-5);
    white-space: nowrap;
  }

  .barra__links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-family: var(--f-display);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-gelo);
    text-decoration: none;
    border-bottom: 3px solid transparent;
    transition: border-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }

  .barra__links a:hover {
    color: var(--c-laranja);
    border-bottom-color: var(--c-laranja);
  }

  @media (min-width: 1024px) {
    .barra__grade {
      grid-template-columns: auto 1fr auto auto;
      grid-template-areas: 'logo nav moedas sair';
      column-gap: var(--e-6);
      min-height: 4.25rem;
    }

    .barra__nav {
      border-top: 0;
    }

    .barra__links {
      justify-content: center;
    }

    .barra__links a {
      min-height: 4.25rem;
    }
  }
</style>
