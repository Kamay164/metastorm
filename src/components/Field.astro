---
/**
 * Campo de formulário: rótulo visível, dica, e área da mensagem de erro.
 * Sem `name` de propósito: é demonstração, nada deve ser enviado.
 * A validação fica em src/scripts/demo-form.ts (usa data-campo / data-erro).
 */
interface Props {
  id: string;
  label: string;
  type?: 'text' | 'email' | 'password';
  hint?: string;
  autocomplete?: string;
  required?: boolean;
  minlength?: number;
  /** id de outro campo que precisa ter o mesmo valor (confirmar senha). */
  igualA?: string;
}
const { id, label, type = 'text', hint, autocomplete, required = true, minlength, igualA } = Astro.props;
const descr = [hint ? `${id}-dica` : null, `${id}-erro`].filter(Boolean).join(' ');
---

<div class="campo" data-campo>
  <label for={id}>{label}</label>
  <div class="campo__caixa">
    <input
      id={id}
      type={type}
      required={required}
      minlength={minlength}
      autocomplete={autocomplete}
      aria-describedby={descr}
      data-igual-a={igualA}
      autocapitalize="off"
      spellcheck="false"
    />
    {
      type === 'password' && (
        <button class="campo__olho" type="button" data-mostrar aria-controls={id} aria-pressed="false">
          Mostrar
        </button>
      )
    }
  </div>
  {hint && <p class="campo__dica" id={`${id}-dica`}>{hint}</p>}
  <p class="campo__erro" id={`${id}-erro`} data-erro></p>
</div>

<style>
  .campo {
    display: grid;
    gap: var(--e-2);
  }

  label {
    font-weight: 500;
    color: var(--fg);
  }

  .campo__caixa {
    position: relative;
  }

  input {
    width: 100%;
    min-height: 3rem;
    padding: 0 var(--e-4);
    border: 1px solid var(--c-aco);
    border-radius: var(--raio);
    background: var(--c-carvao);
    color: var(--c-gelo);
    font: inherit;
    transition: border-color var(--dur) var(--ease);
  }

  input[type='password'] {
    padding-right: 5.5rem;
  }

  input:hover {
    border-color: var(--c-nevoa);
  }

  input:focus-visible {
    outline: 3px solid var(--c-laranja);
    outline-offset: 2px;
    border-color: var(--c-laranja);
  }

  input[aria-invalid='true'] {
    border-color: #ff8a80;
  }

  .campo__olho {
    position: absolute;
    top: 50%;
    right: var(--e-2);
    transform: translateY(-50%);
    min-height: 2.5rem;
    padding: 0 var(--e-3);
    border: 0;
    background: transparent;
    color: var(--c-nevoa);
    font-size: var(--t-sm);
    font-weight: 500;
  }

  .campo__olho:hover {
    color: var(--c-gelo);
  }

  .campo__dica {
    color: var(--c-nevoa);
    font-size: var(--t-sm);
  }

  /* #ff8a80 sobre o carvão: contraste 7:1 */
  .campo__erro {
    color: #ff8a80;
    font-size: var(--t-sm);
    font-weight: 500;
  }

  .campo__erro:empty {
    display: none;
  }
</style>
